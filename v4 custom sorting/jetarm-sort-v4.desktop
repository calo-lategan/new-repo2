[Desktop Entry]
Type=Application
Version=1.0
Name=JetArm Sort v4
Comment=Launch the v4 custom sorting stack with hot-swap models and live tuner
# Use gnome-terminal directly with `bash -i` so ~/.bashrc IS sourced
# (that's what shows the Hiwonder ROS2 environment banner). With
# `Terminal=true` and a non-interactive `bash -c`, .bashrc is skipped
# and you get a plain `ubuntu@ubuntu` prompt instead of the banner.
# install.sh writes a copy with the correct absolute path for $LAUNCHER_DIR.
Exec=gnome-terminal --title=JetArm\ Sort\ v4 -- bash -i -c '"$HOME/jetarm_v4/launch_v4.sh"; exec bash -i'
Terminal=false
Icon=utilities-terminal
Categories=Development;Robotics;
StartupNotify=true
